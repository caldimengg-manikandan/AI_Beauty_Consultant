# ─────────────────────────────────────────────────────────────────────────────
# AI Beauty Consultant — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_256_BIT_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=beauty_consultant

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get FREE test keys from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Email / SMTP (Gmail) ──────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ── Google Places API ─────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ── Redis (optional — for multi-worker rate limiting) ─────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_ENABLED=false

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:8000
